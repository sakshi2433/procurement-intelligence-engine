# ─── Database ───────────────────────────────────────────
DATABASE_URL=postgresql://procurement:procurement@db:5432/procurement_db

# ─── LLM Provider (choose one) ──────────────────────────
# Options: openai | groq | anthropic | ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# OpenAI
OPENAI_API_KEY=sk-your-key-here

# Groq (fast free tier)
# LLM_PROVIDER=groq
# LLM_MODEL=llama3-70b-8192
# GROQ_API_KEY=gsk_your-key-here

# Anthropic
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-haiku-20240307
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Ollama (local)
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# ─── Embeddings ─────────────────────────────────────────
# Options: openai | sentence-transformers
EMBEDDING_PROVIDER=sentence-transformers
# OPENAI_API_KEY is reused if embedding_provider=openai

# ─── Odoo (optional) ────────────────────────────────────
USE_ODOO=false
ODOO_URL=https://your-instance.odoo.com
ODOO_DB=your_db
ODOO_USERNAME=admin@company.com
ODOO_PASSWORD=your_password

# ─── App ────────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000
